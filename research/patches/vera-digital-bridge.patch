--- /dev/null
+++ b/tests/host/vdev/v_skew.v
@@ -0,0 +1,18 @@
+// A skewed bus (tests/host/vdev_host.zig): every 10 ns the 8 bits of q
+// flip one after another, 1 ps apart, q[0] first at 10 ns.
+`timescale 1ns/1ps
+module v_skew(q);
+  output [7:0] q;
+  reg [7:0] q;
+  integer k;
+  initial begin
+    q = 0;
+    forever begin
+      #10;
+      for (k = 0; k < 8; k = k + 1) begin
+        q[k] = ~q[k];
+        if (k < 7) #0.001;
+      end
+    end
+  end
+endmodule
