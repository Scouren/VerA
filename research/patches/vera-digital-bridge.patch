new file mode 100644
index 0000000..efcffa2
--- /dev/null
+++ b/tests/host/vdev/v_edge_clock.v
@@ -0,0 +1,19 @@
+// v_edge with a free-running 1 ns clock feeding a counter no output reads
+// (tests/host/vdev_host.zig): no pin can tell it from v_edge, so a host
+// drives both through the same steps.
+`timescale 1ns/1ps
+module v_edge_clock(clk, q);
+  input clk;
+  output [1:0] q;
+  reg [1:0] q;
+  reg c;
+  reg [7:0] n;
+  initial begin
+    q = 0;
+    c = 0;
+    n = 0;
+  end
+  always #1 c = ~c;
+  always @(posedge c) n <= n + 1;
+  always @(posedge clk) q <= q + 1;
+endmodule
